{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "velle-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-I", "-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 8765
    },
    {
      "name": "velle-next",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-I", "-m", "http.server", "3100", "--bind", "127.0.0.1", "--directory", "web/out"],
      "port": 3100
    },
    {
      "name": "velle-next-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/node_modules/next/dist/bin/next", "dev", "web", "-p", "3200"],
      "port": 3200
    },
    {
      "name": "blackandwhite-recovered",
      "runtimeExecutable": "node",
      "runtimeArgs": ["recovered/blackandwhite/node_modules/next/dist/bin/next", "dev", "recovered/blackandwhite", "-p", "3000"],
      "port": 3000
    }
  ]
}
