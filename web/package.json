{
  "name": "velle-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "postbuild": "cp -R ../site/blackandwhite ../site/static out/ && cp -Rn ../site/_next/static/. out/_next/static/",
    "start": "npx serve out -l 3100",
    "extract": "python3 -I scripts/extract.py ../site content"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
